[Unit]
Description=Sichuan smart-speaker (wake word + converse loop)
# No After=network-online.target: the user manager has no such target, so it
# did nothing. Boot tolerates a missing network (see docs/deployment.md).

[Service]
Type=simple
WorkingDirectory=/home/weilie/sichuan
EnvironmentFile=/home/weilie/.config/sichuan/env
ExecStart=/home/weilie/sichuan/.venv/bin/python /home/weilie/sichuan/wake_then_converse.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
